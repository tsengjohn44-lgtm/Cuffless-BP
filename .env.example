# Copy to .env (never commit .env). The Makefile reads it automatically.

# Where the dataset lives. Default: ./data inside this checkout.
# In a git worktree, point this at the main checkout's data folder so all
# worktrees share one copy of the 3 GB download, e.g.
# BP_DATA_DIR=/Users/you/Cuffless-BP/data
BP_DATA_DIR=data

# Python interpreter used by make. Default: ./.venv/bin/python if it exists, else python.
# In a worktree, point this at the main checkout's venv, e.g.
# PYTHON=/Users/you/Cuffless-BP/.venv/bin/python
